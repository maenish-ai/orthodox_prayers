  "segments": [
    {
      "type": "text",
      "text": {
        "ar": "المديح للقدِّيس نيقولاوس العَجائبي",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "أُسقف ميراليكية",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "المَديح للقدِّيس نيقولاوس العَجائبي",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "القنداق باللحن الرابع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "أيُّها الصانعُ العجائب والمختار من الله لقد أعطيتَ العالم الرحماتِ والعجائبَ الكثيرة، نمدحك بمحبة وبما أنك تملك نعمةً عند الرب أنقذنا من كل المحن نحن الصارخين نحوك:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نيقولاوس العَجائبي العظيم",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "البيت الأول",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يا من هو ملاكٌ على الأرض بالجسد، لقد ظهرَ لكَ مبدعُ الخليقةِ كلِّها وأوقدَ فيكَ محبةَ الخيرِ والصلاح أيُّها المغبوط نيقولاوس فعلمنا أن ننشد لك هكذا:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح أيُّها النقي في بطنِ أمك ومقدسٌ إلى نهاية حياتك",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح أيُّها المولود بالورعِ والتقوى",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح أيُّها المولود بنفسٍ طاهرةٍ ونقاوةٍ فائقة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من حصلتَ على أرضِ الموعد",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا شعاعَ الله المنير",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا كرمةَ الصالحاتِ وغصنَ المسيح",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا شجرةَ عجائبِ فردوسِ المسيح",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا زهرةَ الفردوسِ العَطِرَة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا عطرَ رائحةِ المسيح",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من تزيلُ أحزانَ الكثيرين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا فرح الكثيرين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نيقولاوس العَجائبي العظيم",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "القنداق الأول",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "إننا نمدحكَ أيُّها الحكيم ونتقدسُ بكَ نفسًا وجسدًا يا منْ تُفيض العجائبَ بنعمةِ الله التي تنسكبُ عليكَ وتملأُ الذين يصرخون إلى الله:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "هللويا",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "البيت الثاني",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يا من يمنح العقل لغير المدركين سر الثالوث المقدس. يا من دافعت في نيقية مع الآباء القديسين عن الإيمانِ الأرثوذكسي، يا من اعترفت بمساواة الابن لله الآب في الجوهر. يا من فضحت بدعة آريوس لأجل هذا فإننا نمدحك هاتفين:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا عمودَ الإيمانِ غيرِ المتزعزع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا ملجأ الإيمان القويم",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا قاعدةَ الأرثوذكسيّة الثابتة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا فرحَ الثالوثِ الأقدس",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من وعظتَ بمساواةِ الآب والابن",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من فضحتَ بدعة آريوس ودحضتها",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا فرح الآباءِ وجمالهم، افرح يا جمالَ الحكماء",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من أصبحت مسارًا لنعمة الله",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا معلمَ الرعيةِ الصالح",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا ثباتَ  الإيمانِ القويم",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من دحضت البدعَ الغريبة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نيقولاوس العَجائبي العظيم",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "القنداق الثاني",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "لقد انتزعت من كلّ عينٍ كلَّ دمعة أيها الأب نيقولاوس، لأن الله أعطاك القوةَ لتعزيَ الجميع. وللجائعينَ كنتَ مغذيًا وللمسافرين في البحرِ كنتَ مساعدًا وللسفينةِ قائدًا، وللمرضى شافيًا ولكل محتاجٍ ظهرتَ عونًا ونحن نهتفُ نحوك مسبحين الله وقائلين:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "هللويا",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "البيت الثالث",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "إننا نقرب لك أيُّها القدّيس تسابيحَ وابتهالاتٍ ونكرزُ بعظائمكَ وبمحبة نهتفُ لك هكذا:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح أيُّها الملاكُ والراعي",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا كمالَ القداسة والطهارة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا رجلَ الصلاح والخير للكثيرين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا مسكنَ القداسةِ والطهارة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا مصباحًا ينيرُ المسكونة بالمحبة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نورًا مضيئًا بالبرارة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من استأهلت أن تناجيَ الملائكة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا مرشدَ البشرِ إلى الخيرات",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا قاعدةَ الإيمانِ النقي",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا صورةَ الوداعةِ الروحية",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا خلاصًا من العذاباتِ الروحية",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا خلاصًا من العذابات الجسدية",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا كمالَ الحياة الروحية",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نيقولاوس العَجائبي العظيم",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "القنداق الثالث",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "إننا نرتل لكَ أيُّها القدّيس نيقولاوس بشوقٍ واستحقاقٍ يا من هدأت عاصفة البحر الجائش. ولا يستطع أحدٌ أن يقربَ لكَ الشكرَ الواجبَ بأننا نمجدُ الله بكَ ونتجرّأ أن نرتل:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "هللويا",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "البيت الرابع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "إن القريبَ والبعيدَ يقربُ لكَ التعظيمَ يا حكمةَ الله  ويتحدثُ بعظائمكَ، كأنك بأجنحةِ الملائكة تحضُرُ سريعًا إلى من هم بحاجةٍ مخلصًا إياهم من الشدائدِ والضيقاتِ وهم يرتلون لك قائلين:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا منجيًّا من الأحزان",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا معطيَ وموزعَ البركات",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا مزيل الهموم عن الكثيرين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا واهب المستقين الصلاح",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا عزاءَ المحزونين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا قصاصَ المذنبين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا مفيضَ العجائب",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا كتابَ الشرائعِ الإلهية",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا مرقاةً للساقطين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا ثباتَ الصالحين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من تخزي كلَّ المخادعين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا ثباتًا للحقائق",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نيقولاوس العَجائبي العظيم",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "القنداق الرابع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "لقد ظهرت أيُّها النجمةُ الإلهية ميناءً للمسافرين وهدايةً لهم ونجاةً من الموتِ المحتم لأنهم كانوا يستغيثون بك أيُّها العجيبُ نيقولاوس فانهزمت جيوشُ الشياطين الذين حاولوا إغراقَ المركب، إذ تَعَلّم المسافرون أن يهتفوا بإيمان:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "هللويا",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "البيت الخامس",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "لما عاينتَ الابنةَ البارة مُساقةً إلى الزواج بسببِ فقرها فأظهرت لها الرحمة والعزاء أيها المغبوط نيقولاوس لما حضرتَ إلى أهل الابنة ليلاً معزيًا لهم وقدمتَ لهم الذهبَ سرًا مخلّصًا إيّاهم من العوز ومن الوقوع في الخطيئة لذلك فإنكَ تسمع من الكل هذا الهتاف:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا رحمةَ الذين في الأحزان",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من يرشد الناس إلى التوبة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا غذاءً لكل من يلتجىء إليكَ",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا خبزًا للجائعين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا ثروةَ الفقراء على الأرض أرسلها لهم الله",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا قناعةً للمحتاجين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا سماعًا للمستغيثين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا عنايةً فائقة للمحزونين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا عزاءً للعذارى الثلاث الطاهرات",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا حافظ النقاوة الغيور",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا أمل اليائسين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نيقولاوس العَجائبي العظيم",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "القنداق الخامس",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "إن العالم كلَّه يحدّث بعظيم عجائبك أيُّها الأب نيقولاوس، يا شفيعًا سريعًا في الشدائد. لأنكَ وبساعةٍ واحدةٍ فتديت المسافرين برًا وبحرًا مخلّصًا لهم من الشرورِ لذلك فهم يرتلون لكَ:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "هللويا",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "البيت السادس",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "لقد لمعت أيها النوراني منقذًا وواهبًا النجاة من الموت غير العادل أيُّها الراعي الصالح عندما أنقذت سريعًا المستغيثين بكَ إذ ظهرت في الحلم للملك ووبخته نذيرًا دونَ محاباةٍ للوجوه الذي أعتق المأسورين عنده ونحن نُنشد معهم شاكرين لكَ وقائلين:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا مجيبَ دعواتِ الداعين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا خلاصًا من القتلة الظالمين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا حافظًا من الوشايات الكاذبة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نقاوة الطهارة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح موبخًا الكذبة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا عمودًا للحق",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا معتقًا للذين في السجون ظلمًا",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا مقيمَ الموتى",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا مظهرًا للحقيقة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا موبخًا للكذبة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نجاة البريئين من حد السيف",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من يسطعُ نُورهُ دائمًا",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نيقولاوس العَجائبي العظيم",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "القنداق السادس",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "لقد ضحدتَ وطردتَ قوافلَ الملحدين بسلاحِ البر والتقوى والسلام وظهرتَ معزيًا المؤمنين وملأتهم بالنعمة والسلام والتعزية، فقوينا واطرد عنّا نحن المُثقلين بالخطايا والزلات والتجارب والمحن لنكون مقبولين عند الله ونرتِّل باستحقاقٍ:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "هللويا",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "البيت السابع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يا مرشدَ الضالين الذي يلجأون إلى سفينتكَ كما لجأوا وقتًا ما إلى سفينةِ نوح إذ هدأت العاصفة وقدّت السفينة إلى ميناءِ السلامة برّ الأمان ونحن إذ نمجّد الله الذي منحكَ النعمة نرتِّل لك هاتفين:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا ميناءً هادئًا وأمينًا",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا منقذ وحافظ الغارقين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا غذاءً للسابحين في المياه الهائجة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من هدّأ عواصف البحر الجائش",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا مرافقَ الغارقين إلى اليابسة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا مشتتَ الظلام للمقبلين إليك",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا سراجًا منيرًا لكلِّ الذين يطلبون النور",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من ينجي المؤمنينَ من سقطاتِ الخطيئة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من يطردُ الأعداءَ غير المنظورين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من بشفاعاتكَ نحصلُ على الرحمة الإلهية",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من يساعد شعب الله على النهوض من طوفان الغضب",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نيقولاوس العَجائبي العظيم",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "القنداق السابع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "عجبٌ لا يفسر كيف يتسابق إلى كنائسك المؤمنون أيُّها البار نيقولاوس طالبين معونتك وصلاتك للشفاء من أمراضهم، متوكلين على الله تعالى وعلى شفاعاتك وهم يرتلون:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "هللويا",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "البيت الثامن",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "يا معين الكل بالحقيقة يا لابس الله نيقولاوس، ولقد جمعت صفوف المتهافتين إليك كمنجي ومنقذ، وكطبيبٍ للأوجاع والأحزان، فأنت تستحق من الجميع المديح بالقول هكذا:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا شافيَ الجميع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا معينَ من هم في المصاعب",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نجمًا مضيئًا للخطأة والضالين التائبين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من تهدي القائم في الشدائد",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من يلبي طلبات وابتهالات الصالحين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا مانح السائلين الغلال الوفيرة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا معطي القوة ومجدد همة الضعفاء",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا هدايةً للبشر الضالين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا خادم اسرار الله بصفاء ونقاوة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا سندًا وعونًا للجميع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من بك نهتدي إلى الأخلاق الحميدة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نيقولاوس العَجائبي العظيم",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "القنداق الثامن",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "أيها الشفيع الحارُ نيقولاوس، يا معينًا لإزالة الأمراض يا مانحَ نعمِ الأشفية ومُبهِج النفوس ومُفرِّح القلوب إننا نبادر إليك طالبين العون ومرتِّلين لله:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "هللويا",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "البيت التاسع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "لقد وبّخت الكفرة والمستهزئين أيها الحكيم نيقولاوس، فأنبت آريوس الذي قسّم الألوهية. وسافيلوس الذي زعزع عقيدة الثالوث الأقدس وأنرت لنا الطريق القويم وثبّتنا في الإيمان الحقيقي لأجل هذا نهتف نحوك قائلين:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا ترسَ الإيمان المستقيم الرأي",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا سيفًا مسلطًا على الكفار",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا معلّمًا للإيمان الحقيقي",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا مبيد التعاليم غير القويمة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا سلّمًا مُثبّتًا من الله ومُصعدًا إلى السماوات",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا سترًا إلهيًا يحتمي به الكثيرون",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا مُهذّب الجمال بتعاليمك",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من بأخلاقك تهذّب وترشد الضالين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا سراجًا لا يخبو نوره موضحًا تعاليم ووصايا الله",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا شعاع العدل الإلهي",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من بتعاليمك حطّمت رؤوس الهراطقة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من يهدي المؤمنين إلى المجد",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نيقولاوس العَجائبي العظيم",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "القنداق التاسع",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "لقد خلّصت أيها الأب جسدك وحفظت روحك من الشرور بهدوئك ومحاربتك الأفكار الشريرة، إذ وجّهت عقلك وجسمك نحو الإلهيات لتحصل على الكمال وبذلك منحكَ الله موهبة التكلم مع الملائكة، الذين يرتلون دائمًا:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "هللويا",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "البيت العاشر",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "إنك أيُّها المغبوط عونٌ للذين يسبحونكَ. وعجائبك قوّةٌ وعضدٌ للملتجئين إليك ونحن الساقطون في الضعف والفقر الروحي نهتف نحوك بمحبةٍ هكذا:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا عونًا للمحتاجين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا معطي الغناء الذي لا ينضب",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا طعامًا للجياع إلى البر والخير",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا شرابًا للعطاش إلى الحقيقة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من يُقيّد الذين يخفون الحقيقة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا محرّرًا للأسرى والمقيّدين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا معينًا ومجدًا للذين في الضيقات",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا عونًا للواقعين في الشدائد والضيقات",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا منقذَ الهالكين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا عاضدَ الكثيرين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من بشفاعاتكَ يخلصُ الخطأة الملتجئين إليك",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من بكَ نال التائبون الحياة الأبدية",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نيقولاوس العَجائبي العظيم",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "القنداق العاشر",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "لقد قدّمت الصلوات إلى الثالوث الأقدس أيها المغبوط نيقولاوس بالفكر والكلام والفعل، وبرّرت الواقعين في التجارب بتعاليمك، وعلمتنا جميعًا الإيمان والرجاء والمحبة وأرشدتنا أن نرتل للثالوث الأقدس تسبحة:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "هللويا",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "البيت الحادي عشر",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "إنك شعاع نورلا ينطفىء للقائمين في الظلام أيها الأب نيقولاوس وقد علّمت عن النور الغير المصنوع والغير المخلوق نورالثالوث الأقدس الذي ينير ويقدّس النفوس التي ترتّل لك هكذا:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا شعاع نورالثالوث الأقدس",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا شعاع نورالشمس الذي لا يغرب",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا مصباحَ النورالإلهي الذي لا ينطفىء",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من أخمد لهيب الأبالسة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا كاروزًا بالحقائق الإلهية",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نورَ الإنجيل الواهب الصالحات",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا برقًا محرقًا للهراطقة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا رعدًا مخيفًا للضالين",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا معلمًا للإيمان الحقيقي",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا منيرًا للعقل غير منظور",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا مبطلاً السجود للمخلوقات",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من بك تعلّمنا السجود للثالوث الأقدس",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "ّ",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نيقولاوس العَجائبي العظيم",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "القنداق الحادي عشر",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "لقد أُعطيت لك النعمة من الله الكلي المعرفة، الذي يُسرّ اليوم في تعييدنا لك أيُّها الأب نيقولاوس ونحن",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "نطلب منك العون والشفاعة، وإن أعمالك المجيدة كرمل البحر عددًا، وكنجوم السماء التي لا تحصى تجعلنا نرتّل:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "هللويا",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "البيت الثاني عشر",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "نمدحك عندما نمجد عجائبك أيُّها الفائق المديح نيقولاوس. وبك نمجّد الإله المثلّث الأقانيم وكل المزامير والتسابيح والنشائد المقدّمة لك أيُّها القدّيس العجائبي تجعلنا نقصّر في مديحك. إذ ننذهل ونرتلُ لك هكذا:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا ملك الملوك وسيد الأسياد",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من يخدمه سكانُ السماء",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا عونَ الملوك الحسني العبادة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا رافع شأن المسيحيين الحسني العبادة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نصيرًا للمعيّدين لك",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا إكليل الظفر",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا مراقبًا لكل الأعمال الصالحة",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا عونًا لكلّ الملتجئين إليك",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا رجاءنا عند الله ووالدة الإله",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا صحّة أجسادنا وخلاص نفوسنا",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من بك نخلصُ من الموت الأبدي",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا من بك ننال الحياة الأبدية",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "افرح يا نيقولاوس العَجائبي العظيم",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "القنداق الثاني عشر",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "أيُّها الكلي القداسة والأب نيقولاوس العجائبي، يا فرح كلّ المغمومين اقبل الآن منّا هذا القربان ونجّنا من جهنّم مُتشفعًا فينا أمام الله كي نرتِّل معك إلى الإله العلي:",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "هللويا هللويا هللويا",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "ثمّ يُعاد البيت الأول والقنداق الأول",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "صلاة للقديس",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "نيقولاوس الكلي القداسة، المُختار من الرب، المدافع عنّا بحرارة وشغف ومُنقذنا من كلّ المحن، ساعدني",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "أنا المخطىء والحزين في حياتي الحالية، صلّي للسيد الرب ليخلّصني من جميع خطاياي المقترفة في شبابي وكلّ حياتي. بالعمل والكلمة والتفكير وفي كلِّ أحاسيسي وعند صعود روحي ساعدني أنا المذنب وتضرع لله الخالق المبدع، ان يخلصني من الضياع والعذاب الأبدي .",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "للأبد أمجّد الآب والابن والروح القدس وحضورك المبهج أمام الرب الآن وكلَّ أوانٍ وإلى أبد الآبدين آمين.",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "صلاة للقديس",
        "en": "",
        "el": ""
      }
    },
    {
      "type": "text",
      "text": {
        "ar": "أيُّها الفائق المديح الأب نيقولاوس راعي ومعلّم جميع المؤمنين القادمين إليك لنيل شفاعتك وحمايتك، بصلواتنا وتضرعنا إليك لإنقاذ قطيع المسيح من الذئاب، واحم كل بلاد المسيحيين وسوّرها بصلواتك المقدسة من حقد المتآمرين وحملات قبائل الغرباء ومن حروب الأخوة ، من الجوع والفيضانات والنار والسيف والموت الفجائي. وكذلك اغفر لي خطاياي وابعدني عن غضب الله والمعاناة البدية. وبتوصيتك أمام الله، وبمحبتي وتمجيدي للمسيح الإله ليعطني الرب حياةً هادئة وبدون أخطاء لأعيش في هذا العصر. وليخلّصني من دهاء الشيطان. آمين.",
        "en": "",
        "el": ""
      }
    }
  ],
  "content_kind": "native_text"
}
